<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TodoApp"
        xmlns:conv="clr-namespace:TodoApp.Converters"
        xmlns:beh="clr-namespace:TodoApp.Behaviors"
        xmlns:docs="clr-namespace:System.Windows.Documents;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:TodoApp.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="740" Width="1180" MinHeight="520" MinWidth="860"
        Icon="Assets/icon.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddTaskCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
        <KeyBinding Key="F11" Command="{Binding ToggleFocusModeCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveFileAsCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <!-- Ctrl+Shift+P/L/C/K/F and Ctrl+E are handled in Window_PreviewKeyDown instead of as
             KeyBindings here - they call the same AddPhoto_Click/AddLink_Click/AddChecklist_Click/
             AddTable_Click/AddFile_Click/ExportNote_Click handlers the toolbar buttons use, which
             insert inline into NoteEditor. The KeyBindings that used to live here instead called
             SelectedTaskDetail.Add*BlockCommand, which add to the now-unrendered Task.Body block
             list from the old per-block editor - removed as dead/misleading now that
             Window_PreviewKeyDown's e.Handled=true pre-empts them anyway. -->
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:DueDateToStringConverter x:Key="DueDateToString"/>
        <conv:DueDateColorConverter x:Key="DueDateColor"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVis"/>
        <conv:CloseReopenLabelConverter x:Key="CloseReopenLabel"/>
        <conv:CloseReopenIconConverter x:Key="CloseReopenIcon"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:EnumEqualsVisibilityConverter x:Key="EnumEqualsVis"/>
        <conv:EnumNotEqualsVisibilityConverter x:Key="EnumNotEqualsVis"/>
        <conv:PinLabelConverter x:Key="PinLabel"/>
        <conv:BoolToGridLengthConverter x:Key="BoolToGridLength"/>
        <conv:HasAttachmentConverter x:Key="HasAttachmentToVis"/>
        <conv:AnyItemToVisibilityConverter x:Key="AnyItemToVis"/>
        <conv:HasBlockTypeConverter x:Key="HasBlockTypeToVis"/>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVis"/>
        <conv:MarkCompletedVisibilityConverter x:Key="MarkCompletedVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>

        <!-- Plain TextBoxes with no ContextMenu of their own fall back to WPF's own
             auto-generated Cut/Copy/Paste(/spelling) menu - which, like every other piece of
             native WPF chrome in this app, doesn't pick up the app's dark theme on its own and
             renders as an unthemed white box. Giving each one this explicit menu instead routes
             it through the same themed MenuItem/ContextMenu styles as everywhere else; spelling
             suggestions are merged in via TextBox_ContextMenuOpening, same approach as the note
             editor's RichTextBox. Shared across every plain TextBox in this window (safe - only
             one can be open at a time), separate from the RichTextBox's own formatting menu. -->
        <ContextMenu x:Key="TextEditContextMenu">
            <MenuItem Header="Cu_t" Command="Cut"/>
            <MenuItem Header="_Copy" Command="Copy"/>
            <MenuItem Header="_Paste" Command="Paste"/>
        </ContextMenu>

        <ContextMenu x:Key="TextEditorContextMenu">
            <MenuItem Header="Cu_t" Command="Cut"/>
            <MenuItem Header="_Copy" Command="Copy"/>
            <MenuItem Header="_Paste" Command="Paste"/>
            <Separator/>
            <MenuItem Header="Bold" FontWeight="Bold" Click="Bold_Click"/>
            <MenuItem Header="Italic" FontStyle="Italic" Click="Italic_Click"/>
            <MenuItem Click="Underline_Click">
                <MenuItem.Header>
                    <TextBlock Text="Underline" TextDecorations="Underline"/>
                </MenuItem.Header>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Font Size">
                <MenuItem Header="10" Tag="10" Click="FontSize_Click"/>
                <MenuItem Header="12" Tag="12" Click="FontSize_Click"/>
                <MenuItem Header="14" Tag="14" Click="FontSize_Click"/>
                <MenuItem Header="16" Tag="16" Click="FontSize_Click"/>
                <MenuItem Header="18" Tag="18" Click="FontSize_Click"/>
                <MenuItem Header="24" Tag="24" Click="FontSize_Click"/>
                <MenuItem Header="32" Tag="32" Click="FontSize_Click"/>
            </MenuItem>
            <MenuItem Header="Text Color">
                <MenuItem Header="Black" Tag="#2C3338" Click="TextColor_Click">
                    <MenuItem.Icon><Border Background="#2C3338" Width="12" Height="12"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Red" Tag="#D63638" Click="TextColor_Click">
                    <MenuItem.Icon><Border Background="#D63638" Width="12" Height="12"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Orange" Tag="#E68A00" Click="TextColor_Click">
                    <MenuItem.Icon><Border Background="#E68A00" Width="12" Height="12"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Green" Tag="#00A32A" Click="TextColor_Click">
                    <MenuItem.Icon><Border Background="#00A32A" Width="12" Height="12"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Blue" Tag="#3361CC" Click="TextColor_Click">
                    <MenuItem.Icon><Border Background="#3361CC" Width="12" Height="12"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Purple" Tag="#8C4FE0" Click="TextColor_Click">
                    <MenuItem.Icon><Border Background="#8C4FE0" Width="12" Height="12"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Highlight">
                <MenuItem Header="None" Tag="Transparent" Click="HighlightColor_Click"/>
                <MenuItem Header="Yellow" Tag="#FFF3B0" Click="HighlightColor_Click">
                    <MenuItem.Icon><Border Background="#FFF3B0" Width="12" Height="12"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Green" Tag="#C8F0C8" Click="HighlightColor_Click">
                    <MenuItem.Icon><Border Background="#C8F0C8" Width="12" Height="12"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Blue" Tag="#CEE0FA" Click="HighlightColor_Click">
                    <MenuItem.Icon><Border Background="#CEE0FA" Width="12" Height="12"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Pink" Tag="#FAD1E0" Click="HighlightColor_Click">
                    <MenuItem.Icon><Border Background="#FAD1E0" Width="12" Height="12"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Bulleted List" Click="Bullets_Click"/>
            <MenuItem Header="Numbered List" Click="Numbering_Click"/>
            <Separator/>
            <MenuItem Header="Insert Photo..." Click="AddPhoto_Click"/>
            <MenuItem Header="Insert Link..." Click="AddLink_Click"/>
            <MenuItem Header="Insert Checklist Item" Click="AddChecklist_Click"/>
            <MenuItem Header="Insert Table..." Click="AddTable_Click"/>
            <MenuItem Header="Insert File..." Click="AddFile_Click"/>
            <Separator/>
            <MenuItem Header="Export / Print Note..." Click="ExportNote_Click"/>
        </ContextMenu>

        <DataTemplate x:Key="SidebarItemTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Background="Transparent"
                        ToolTip="{Binding Label}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Width="18" TextAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="{Binding Label}" FontSize="13.5" Margin="8,0,0,0"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}"/>
                <!-- ContextMenu opens in its own popup, disconnected from the main visual tree, so
                     RelativeSource AncestorType=Window can't find the ancestor from in here. Instead,
                     the MainViewModel was stashed on the StackPanel's Tag above (where AncestorType=Window
                     still works), and each item reaches it via ContextMenu.PlacementTarget.Tag. -->
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="SORT BY" IsEnabled="False" FontSize="11" FontWeight="Bold"
                                  Visibility="{Binding Kind, Converter={StaticResource EnumNotEqualsVis}, ConverterParameter=Trash}"/>
                        <MenuItem Header="Name (A-Z)"
                                  Visibility="{Binding Kind, Converter={StaticResource EnumNotEqualsVis}, ConverterParameter=Trash}"
                                  Command="{Binding PlacementTarget.Tag.SetSortCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{x:Static vm:SortOption.NameAZ}"/>
                        <MenuItem Header="Name (Z-A)"
                                  Visibility="{Binding Kind, Converter={StaticResource EnumNotEqualsVis}, ConverterParameter=Trash}"
                                  Command="{Binding PlacementTarget.Tag.SetSortCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{x:Static vm:SortOption.NameZA}"/>
                        <MenuItem Header="Due Date"
                                  Visibility="{Binding Kind, Converter={StaticResource EnumNotEqualsVis}, ConverterParameter=Trash}"
                                  Command="{Binding PlacementTarget.Tag.SetSortCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{x:Static vm:SortOption.DueDateSoonest}"/>
                        <MenuItem Header="Date Modified"
                                  Visibility="{Binding Kind, Converter={StaticResource EnumNotEqualsVis}, ConverterParameter=Trash}"
                                  Command="{Binding PlacementTarget.Tag.SetSortCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{x:Static vm:SortOption.ModifiedNewest}"/>
                        <MenuItem Header="Date Created"
                                  Visibility="{Binding Kind, Converter={StaticResource EnumNotEqualsVis}, ConverterParameter=Trash}"
                                  Command="{Binding PlacementTarget.Tag.SetSortCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{x:Static vm:SortOption.CreatedNewest}"/>
                        <Separator Visibility="{Binding Kind, Converter={StaticResource EnumNotEqualsVis}, ConverterParameter=Trash}"/>
                        <MenuItem Header="Move All to Trash"
                                  Visibility="{Binding Kind, Converter={StaticResource EnumEqualsVis}, ConverterParameter=Done}"
                                  Command="{Binding PlacementTarget.Tag.TrashAllClosedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Empty Trash"
                                  Visibility="{Binding Kind, Converter={StaticResource EnumEqualsVis}, ConverterParameter=Trash}"
                                  Command="{Binding PlacementTarget.Tag.EmptyTrashCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </StackPanel.ContextMenu>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource SidebarBackgroundBrush}"
              BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File" Template="{StaticResource MenuItemTopLevelHeaderTemplate}">
                <MenuItem Header="_New Task" InputGestureText="Ctrl+N" Command="{Binding AddTaskCommand}"/>
                <MenuItem Header="_Delete Task" InputGestureText="Del" Command="{Binding DeleteSelectedCommand}"/>
                <Separator/>
                <MenuItem Header="Ne_w Data File..." Command="{Binding NewFileCommand}"/>
                <MenuItem Header="_Open Data File..." InputGestureText="Ctrl+O" Command="{Binding OpenFileCommand}"/>
                <MenuItem Header="Save Data File _As..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveFileAsCommand}"/>
                <MenuItem Header="Export Selected Note..." InputGestureText="Ctrl+E" Click="ExportNote_Click"/>
                <MenuItem Header="_Restore from Backup..." Command="{Binding RestoreBackupCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit" Template="{StaticResource MenuItemTopLevelHeaderTemplate}">
                <MenuItem Header="{Binding UndoMenuLabel}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"/>
                <Separator/>
                <MenuItem Header="Cu_t" Command="Cut"/>
                <MenuItem Header="_Copy" Command="Copy"/>
                <MenuItem Header="_Paste" Command="Paste"/>
            </MenuItem>
            <MenuItem Header="_View" Template="{StaticResource MenuItemTopLevelHeaderTemplate}">
                <MenuItem Header="_All Tasks" Command="{Binding ShowAllCommand}"/>
                <MenuItem Header="_Completed" Command="{Binding ShowClosedCommand}"/>
                <MenuItem Header="_Trash" Command="{Binding ShowTrashCommand}"/>
                <Separator/>
                <MenuItem Header="_Dark Theme" IsCheckable="True" IsChecked="{Binding IsDarkTheme}"/>
                <MenuItem Header="F_ocus Mode" InputGestureText="F11" IsCheckable="True" IsChecked="{Binding IsFocusMode}"/>
                <MenuItem Header="_Reminders" IsCheckable="True" IsChecked="{Binding RemindersEnabled}"/>
            </MenuItem>
            <MenuItem Header="_Window" Template="{StaticResource MenuItemTopLevelHeaderTemplate}">
                <MenuItem Header="Always on _Top" IsCheckable="True" Checked="AlwaysOnTop_Checked" Unchecked="AlwaysOnTop_Unchecked"/>
            </MenuItem>
            <MenuItem Header="_Help" Template="{StaticResource MenuItemTopLevelHeaderTemplate}">
                <MenuItem Header="Open _Debug Log File..." Click="OpenDebugLog_Click"/>
                <MenuItem Header="_Clear Debug Log File..." Command="{Binding ClearDebugLogCommand}"/>
                <Separator/>
                <MenuItem Header="_Verbose Logging" IsCheckable="True" IsChecked="{Binding IsVerboseLogging}"/>
                <Separator/>
                <MenuItem Header="_About Tasky" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True"
                 Background="{DynamicResource SidebarBackgroundBrush}">
            <Button ToolTip="New Task (Ctrl+N)" Command="{Binding AddTaskCommand}" Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2795;" FontSize="12" Margin="0,0,5,0"/>
                    <TextBlock Text="New"/>
                </StackPanel>
            </Button>
            <Button ToolTip="Delete Task (Del)" Command="{Binding DeleteSelectedCommand}" Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F5D1;" FontSize="12" Margin="0,0,5,0"/>
                    <TextBlock Text="Delete"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button ToolTip="Show all open tasks" Command="{Binding ShowAllCommand}" Padding="6,3">
                <TextBlock Text="All Tasks"/>
            </Button>
            <Button ToolTip="Show completed tasks" Command="{Binding ShowClosedCommand}" Padding="6,3">
                <TextBlock Text="Completed"/>
            </Button>
            <Button ToolTip="Show trash" Command="{Binding ShowTrashCommand}" Padding="6,3">
                <TextBlock Text="Trash"/>
            </Button>
            <Separator/>
            <Button ToolTip="Focus mode (F11)" Command="{Binding ToggleFocusModeCommand}" Padding="6,3">
                <TextBlock Text="&#x26F6; Focus"/>
            </Button>
            <Separator x:Name="FormattingGroupSeparator" Visibility="Collapsed"/>
            <!-- Only meaningful while a text block's RichTextBox has focus - starts disabled and
                 is toggled from code-behind (RichTextBox_GotFocus/LostFocus, and reset whenever
                 the selected task changes) since _activeEditor is code-behind state, not a bound
                 view-model property.

                 ToolBar normally auto-applies its flat ToolBar.*StyleKey styles to its DIRECT
                 Items automatically (see ControlStyles.xaml) - but that only walks ToolBar.Items
                 itself, not descendants nested inside a child panel. Now that this StackPanel is
                 the direct item instead of these controls, each one needs that style applied
                 explicitly or it'd silently fall back to the app-wide bordered Button/ComboBox
                 style instead of the flat toolbar look. -->
            <StackPanel x:Name="FormattingGroup" Orientation="Horizontal" IsEnabled="False" Visibility="Collapsed">
                <ComboBox x:Name="FontFamilyCombo" Width="115" SelectedIndex="0"
                          Style="{StaticResource {x:Static ToolBar.ComboBoxStyleKey}}"
                          SelectionChanged="FontFamilyCombo_SelectionChanged" ToolTip="Font">
                    <ComboBoxItem>Segoe UI</ComboBoxItem>
                    <ComboBoxItem>Calibri</ComboBoxItem>
                    <ComboBoxItem>Arial</ComboBoxItem>
                    <ComboBoxItem>Georgia</ComboBoxItem>
                    <ComboBoxItem>Times New Roman</ComboBoxItem>
                    <ComboBoxItem>Consolas</ComboBoxItem>
                </ComboBox>
                <ComboBox Width="55" Margin="4,0,0,0" SelectedIndex="2"
                          Style="{StaticResource {x:Static ToolBar.ComboBoxStyleKey}}"
                          SelectionChanged="FontSizeCombo_SelectionChanged" ToolTip="Font size">
                    <ComboBoxItem>10</ComboBoxItem>
                    <ComboBoxItem>12</ComboBoxItem>
                    <ComboBoxItem>13.5</ComboBoxItem>
                    <ComboBoxItem>16</ComboBoxItem>
                    <ComboBoxItem>18</ComboBoxItem>
                    <ComboBoxItem>24</ComboBoxItem>
                    <ComboBoxItem>32</ComboBoxItem>
                </ComboBox>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
                <Button x:Name="BoldButton" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="Bold_Click" ToolTip="Bold (applies to the last text block you clicked into)" Padding="7,3">
                    <TextBlock Text="B" FontWeight="Bold" FontSize="13"/>
                </Button>
                <Button x:Name="ItalicButton" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="Italic_Click" ToolTip="Italic" Padding="7,3">
                    <TextBlock Text="I" FontStyle="Italic" FontSize="13"/>
                </Button>
                <Button x:Name="UnderlineButton" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Click="Underline_Click" ToolTip="Underline" Padding="7,3">
                    <TextBlock Text="U" TextDecorations="Underline" FontSize="13"/>
                </Button>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
                <TextBlock Text="A" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="2,0,3,0"
                           Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Text color"/>
                <ComboBox Width="46" SelectedIndex="0"
                          Style="{StaticResource {x:Static ToolBar.ComboBoxStyleKey}}"
                          SelectionChanged="TextColorCombo_SelectionChanged" ToolTip="Text color">
                    <ComboBoxItem Tag="#2C3338"><Border Background="#2C3338" Width="16" Height="16"/></ComboBoxItem>
                    <ComboBoxItem Tag="#D63638"><Border Background="#D63638" Width="16" Height="16"/></ComboBoxItem>
                    <ComboBoxItem Tag="#E68A00"><Border Background="#E68A00" Width="16" Height="16"/></ComboBoxItem>
                    <ComboBoxItem Tag="#00A32A"><Border Background="#00A32A" Width="16" Height="16"/></ComboBoxItem>
                    <ComboBoxItem Tag="#3361CC"><Border Background="#3361CC" Width="16" Height="16"/></ComboBoxItem>
                    <ComboBoxItem Tag="#8C4FE0"><Border Background="#8C4FE0" Width="16" Height="16"/></ComboBoxItem>
                </ComboBox>
                <TextBlock Text="&#x1F58D;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="8,0,3,0"
                           Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Highlight"/>
                <ComboBox Width="50" SelectedIndex="0"
                          Style="{StaticResource {x:Static ToolBar.ComboBoxStyleKey}}"
                          SelectionChanged="HighlightCombo_SelectionChanged" ToolTip="Highlight">
                    <ComboBoxItem Tag="Transparent"><TextBlock Text="None" FontSize="10"/></ComboBoxItem>
                    <ComboBoxItem Tag="#FFF3B0"><Border Background="#FFF3B0" Width="16" Height="16"/></ComboBoxItem>
                    <ComboBoxItem Tag="#C8F0C8"><Border Background="#C8F0C8" Width="16" Height="16"/></ComboBoxItem>
                    <ComboBoxItem Tag="#CEE0FA"><Border Background="#CEE0FA" Width="16" Height="16"/></ComboBoxItem>
                    <ComboBoxItem Tag="#FAD1E0"><Border Background="#FAD1E0" Width="16" Height="16"/></ComboBoxItem>
                </ComboBox>
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
                <TextBlock Text="&#x2261;" FontSize="15" VerticalAlignment="Center" Margin="2,0,3,0"
                           Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="List style"/>
                <ComboBox Width="80" SelectedIndex="-1"
                          Style="{StaticResource {x:Static ToolBar.ComboBoxStyleKey}}"
                          SelectionChanged="ListStyleCombo_SelectionChanged" ToolTip="List style">
                    <ComboBoxItem Tag="Bullets"><TextBlock Text="&#x2022; Bullets" FontSize="11"/></ComboBoxItem>
                    <ComboBoxItem Tag="Numbering"><TextBlock Text="1. Numbered" FontSize="11"/></ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </ToolBar>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="0,1,0,0" Padding="10,3">
            <TextBlock Text="{Binding SaveStatusText}" FontSize="11" Foreground="{DynamicResource TertiaryBrush}"/>
        </Border>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}"/>
            <ColumnDefinition Width="{Binding IsFocusMode, Converter={StaticResource BoolToGridLength}, ConverterParameter=340}"/>
            <ColumnDefinition Width="{Binding IsFocusMode, Converter={StaticResource BoolToGridLength}, ConverterParameter=5}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: All Tasks / Completed / Trash, then a separated Tags section -->
        <Grid Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10,10,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TASKY" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}" Margin="4,0,0,0"
                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding ToggleSidebarCommand}"
                        ToolTip="Collapse/expand sidebar" AutomationProperties.Name="Collapse or expand sidebar">
                    <TextBlock Text="&#x2630;" Style="{StaticResource IconGlyph}"/>
                </Button>
            </Grid>

            <ListBox x:Name="SidebarListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                      ItemsSource="{Binding SidebarItems}" SelectedItem="{Binding SelectedSidebarItem}"
                      ItemContainerStyle="{StaticResource ThemedListBoxItem}"
                      ItemTemplate="{StaticResource SidebarItemTemplate}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>

            <Separator Grid.Row="2" Margin="10,6" Background="{DynamicResource SecondaryBrush}"/>

            <TextBlock Grid.Row="3" Text="TAGS" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}" Margin="14,0,14,6"
                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"/>

            <ListBox x:Name="TagListBox" Grid.Row="4" Background="Transparent" BorderThickness="0"
                      ItemsSource="{Binding TagItems}" SelectedItem="{Binding SelectedSidebarItem}"
                      ItemContainerStyle="{StaticResource ThemedListBoxItem}"
                      ItemTemplate="{StaticResource SidebarItemTemplate}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Grid>

        <!-- Task list -->
        <Grid Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,10,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource IconButton}" ToolTip="New Task (Ctrl+N)"
                        AutomationProperties.Name="New task"
                        Command="{Binding AddTaskCommand}">
                    <TextBlock Text="&#x2795;" Style="{StaticResource IconGlyph}"/>
                </Button>

                <Grid Grid.Column="1" Margin="6,0">
                    <TextBox Padding="22,6,6,6" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search tasks, notes, and tags (try tag:name)"/>
                    <TextBlock Text="&#x1F50D;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{DynamicResource TertiaryBrush}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>

                <Button x:Name="FilterButton" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Quick filter"
                        AutomationProperties.Name="Quick filter"
                        Command="{Binding ToggleFilterPopupCommand}">
                    <TextBlock Text="&#x2699;" Style="{StaticResource IconGlyph}"/>
                </Button>
                <Popup PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom"
                       IsOpen="{Binding IsFilterPopupOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SecondaryBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="3">
                        <StackPanel>
                            <Button Content="All Tasks" HorizontalContentAlignment="Left" Padding="8,5" Background="Transparent" BorderThickness="0"
                                    Command="{Binding SetQuickFilterCommand}" CommandParameter="{x:Static vm:QuickFilter.None}"/>
                            <Button Content="Overdue" HorizontalContentAlignment="Left" Padding="8,5" Background="Transparent" BorderThickness="0"
                                    Command="{Binding SetQuickFilterCommand}" CommandParameter="{x:Static vm:QuickFilter.Overdue}"/>
                            <Button Content="Due Today" HorizontalContentAlignment="Left" Padding="8,5" Background="Transparent" BorderThickness="0"
                                    Command="{Binding SetQuickFilterCommand}" CommandParameter="{x:Static vm:QuickFilter.DueToday}"/>
                            <Button Content="No Due Date" HorizontalContentAlignment="Left" Padding="8,5" Background="Transparent" BorderThickness="0"
                                    Command="{Binding SetQuickFilterCommand}" CommandParameter="{x:Static vm:QuickFilter.NoDueDate}"/>
                            <Button Content="Recurring" HorizontalContentAlignment="Left" Padding="8,5" Background="Transparent" BorderThickness="0"
                                    Command="{Binding SetQuickFilterCommand}" CommandParameter="{x:Static vm:QuickFilter.Recurring}"/>
                            <Button Content="With Link" HorizontalContentAlignment="Left" Padding="8,5" Background="Transparent" BorderThickness="0"
                                    Command="{Binding SetQuickFilterCommand}" CommandParameter="{x:Static vm:QuickFilter.HasLink}"/>
                            <Button Content="With Attachment" HorizontalContentAlignment="Left" Padding="8,5" Background="Transparent" BorderThickness="0"
                                    Command="{Binding SetQuickFilterCommand}" CommandParameter="{x:Static vm:QuickFilter.HasAttachment}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <ListBox x:Name="TaskListBox" Grid.Row="1" Background="Transparent" BorderThickness="0,1,0,0"
                      BorderBrush="{DynamicResource SecondaryBrush}" SelectionMode="Extended"
                      ItemsSource="{Binding FilteredTasksView}" SelectedItem="{Binding SelectedTask}"
                      ItemContainerStyle="{StaticResource TaskListItemStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="TaskListBox_SelectionChanged"
                      PreviewMouseRightButtonDown="TaskListBox_PreviewMouseRightButtonDown"
                      Tag="{Binding}">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Mark Completed"
                                  Visibility="{Binding PlacementTarget.Tag.SelectedSidebarItem.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource MarkCompletedVis}}"
                                  Command="{Binding PlacementTarget.Tag.BulkMarkDoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Pin/Unpin"
                                  Command="{Binding PlacementTarget.Tag.BulkTogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Move to Trash"
                                  Visibility="{Binding PlacementTarget.Tag.SelectedSidebarItem.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource EnumNotEqualsVis}, ConverterParameter=Trash}"
                                  Command="{Binding PlacementTarget.Tag.BulkTrashCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Restore from Trash"
                                  Visibility="{Binding PlacementTarget.Tag.SelectedSidebarItem.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource EnumEqualsVis}, ConverterParameter=Trash}"
                                  Command="{Binding PlacementTarget.Tag.BulkRestoreCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Delete Permanently"
                                  Command="{Binding PlacementTarget.Tag.BulkDeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Style="{StaticResource CircleCheckBox}"
                                      VerticalAlignment="Top" Margin="0,2,6,0" ToolTip="Mark completed"
                                      AutomationProperties.Name="Mark completed"
                                      IsChecked="{Binding IsDone}"
                                      IsEnabled="{Binding IsClosed, Converter={StaticResource InverseBool}}"/>

                            <TextBlock Grid.Column="1" Text="&#x1F4CC;" FontSize="11" VerticalAlignment="Top"
                                       Margin="0,2,6,0" Cursor="Hand" ToolTip="Pin to top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.15"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5"
                                           Foreground="{DynamicResource PrimaryTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DueDate, Converter={StaticResource DueDateToString}}"
                                           FontSize="10.5" Margin="0,2,0,0"
                                           Visibility="{Binding DueDate, Converter={StaticResource NullToVis}}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource DueDateColor}">
                                            <Binding Path="DueDate"/>
                                            <Binding Path="IsDone"/>
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="&#x1F5BC;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{DynamicResource TertiaryBrush}" Margin="0,0,6,0"
                                               ToolTip="Has photo"
                                               Visibility="{Binding Converter={StaticResource HasBlockTypeToVis}, ConverterParameter=Photo}"/>
                                    <TextBlock Text="&#x1F4CE;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{DynamicResource TertiaryBrush}" Margin="0,0,6,0"
                                               ToolTip="Has file attachment"
                                               Visibility="{Binding Converter={StaticResource HasBlockTypeToVis}, ConverterParameter=File}"/>
                                    <TextBlock Text="&#x1F517;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{DynamicResource TertiaryBrush}" Margin="0,0,6,0"
                                               ToolTip="Has link"
                                               Visibility="{Binding Converter={StaticResource HasBlockTypeToVis}, ConverterParameter=Link}"/>
                                    <TextBlock Text="&#x2611;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{DynamicResource TertiaryBrush}" Margin="0,0,6,0"
                                               ToolTip="Has checklist"
                                               Visibility="{Binding Converter={StaticResource HasBlockTypeToVis}, ConverterParameter=Checklist}"/>
                                    <TextBlock Text="&#x1F3F7;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{DynamicResource TertiaryBrush}" Margin="0,0,6,0"
                                               ToolTip="Has tags"
                                               Visibility="{Binding Tags, Converter={StaticResource AnyItemToVis}}"/>
                                    <TextBlock Text="&#x1F501;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{DynamicResource TertiaryBrush}"
                                               ToolTip="Recurring"
                                               Visibility="{Binding Recurrence, Converter={StaticResource EnumNotEqualsVis}, ConverterParameter=None}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1" Text="{Binding EmptyStateMessage}"
                       Visibility="{Binding FilteredTasksView.IsEmpty, Converter={StaticResource BoolToVis}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       FontSize="13" Foreground="{DynamicResource TertiaryBrush}" TextWrapping="Wrap"
                       MaxWidth="180" IsHitTestVisible="False"/>
        </Grid>

        <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource SecondaryBrush}"/>

        <!-- Editor -->
        <Grid Grid.Column="3" Background="{DynamicResource BackgroundBrush}">
            <TextBlock Text="Select a task, or create a new one."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{DynamicResource TertiaryBrush}"
                       Visibility="{Binding SelectedTaskDetail, Converter={StaticResource InverseNullToVis}}"/>

            <!-- A DataContext binding and a Visibility binding on the SAME element both referencing
                 SelectedTaskDetail is a classic WPF trap: once DataContext resolves to the
                 TaskDetailViewModel, the Visibility binding re-resolves "SelectedTaskDetail" against
                 THAT object (which has no such property) instead of the parent MainViewModel, fails
                 silently, and falls back to its default (Visible) - so this pane never actually hid.
                 The outer Grid here carries the Visibility check against the untouched parent
                 DataContext; only the ScrollViewer inside overrides DataContext. -->
            <Grid Visibility="{Binding SelectedTaskDetail, Converter={StaticResource NullToVis}}"
                  AllowDrop="True"
                  PreviewDragEnter="Body_DragEnter"
                  PreviewDragOver="Body_DragOver"
                  PreviewDragLeave="Body_DragLeave"
                  PreviewDrop="Body_Drop">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,20"
                          DataContext="{Binding SelectedTaskDetail}">
                <StackPanel>
                    <!-- Icon toolbar - sits above the title, like a ribbon above the document itself. -->
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Style="{StaticResource CircleCheckBox}" VerticalAlignment="Center" Margin="0,0,10,0"
                                  ToolTip="Mark completed" AutomationProperties.Name="Mark completed"
                                  IsChecked="{Binding Task.IsDone}"
                                  IsEnabled="{Binding CanToggleComplete}"/>

                        <Button Style="{StaticResource IconButton}"
                                AutomationProperties.Name="{Binding Task.IsPinned, Converter={StaticResource PinLabel}}"
                                Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Task}">
                            <Button.ToolTip>
                                <Binding Path="Task.IsPinned" Converter="{StaticResource PinLabel}"/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x1F4CC;">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
                                        <Setter Property="Opacity" Value="0.35"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Task.IsPinned}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <Separator Width="8" Background="Transparent"/>

                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsEditable}">
                            <Button Style="{StaticResource IconButton}" Click="AddPhoto_Click" ToolTip="Add photo inline (Ctrl+Shift+P)"
                                    AutomationProperties.Name="Add photo">
                                <TextBlock Text="&#x1F5BC;" Style="{StaticResource IconGlyph}"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="AddLink_Click" ToolTip="Add link inline (Ctrl+Shift+L)"
                                    AutomationProperties.Name="Add link">
                                <TextBlock Text="&#x1F517;" Style="{StaticResource IconGlyph}"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="AddChecklist_Click" ToolTip="Add checklist item (Ctrl+Shift+C)"
                                    AutomationProperties.Name="Add checklist">
                                <TextBlock Text="&#x2611;" Style="{StaticResource IconGlyph}"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="AddTable_Click" ToolTip="Insert Table (Ctrl+Shift+K)"
                                    AutomationProperties.Name="Insert table">
                                <TextBlock Text="&#x229E;" Style="{StaticResource IconGlyph}"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="AddFile_Click" ToolTip="Add file inline (Ctrl+Shift+F)"
                                    AutomationProperties.Name="Add file">
                                <TextBlock Text="&#x1F4CE;" Style="{StaticResource IconGlyph}"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="ExportNote_Click" ToolTip="Export / Print Note (Ctrl+E)"
                                    AutomationProperties.Name="Export note">
                                <TextBlock Text="&#x1F4E4;" Style="{StaticResource IconGlyph}"/>
                            </Button>
                            <Button x:Name="TagIconButton" Style="{StaticResource IconButton}"
                                    Command="{Binding ToggleTagPopupCommand}" ToolTip="Add tag" AutomationProperties.Name="Add tag">
                                <TextBlock Text="&#x1F3F7;" Style="{StaticResource IconGlyph}"/>
                            </Button>
                            <Popup PlacementTarget="{Binding ElementName=TagIconButton}" Placement="Bottom"
                                   IsOpen="{Binding IsTagPopupOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SecondaryBrush}"
                                        BorderThickness="1" CornerRadius="3" Padding="8">
                                    <StackPanel Width="200">
                                        <TextBox Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}"
                                                 Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="Type a tag and press Enter"
                                                 SpellCheck.IsEnabled="True" ContextMenu="{StaticResource TextEditContextMenu}"
                                                 PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown"
                                                 ContextMenuOpening="TextBox_ContextMenuOpening">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddTagCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="{Binding TagHint}" FontSize="10.5" Margin="2,4,2,0"
                                                   Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding FilteredAvailableTags}" Margin="0,6,0,0"
                                                      MaxHeight="180">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button HorizontalContentAlignment="Left" Padding="6,4" Margin="0,0,0,1"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.SelectExistingTagCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding}" FontSize="12.5"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>

                        <Separator Width="8" Background="Transparent"/>

                        <Button Style="{StaticResource IconButton}"
                                AutomationProperties.Name="{Binding Task.IsClosed, Converter={StaticResource CloseReopenLabel}}"
                                Command="{Binding DataContext.ToggleCloseSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Button.ToolTip>
                                <Binding Path="Task.IsClosed" Converter="{StaticResource CloseReopenLabel}"/>
                            </Button.ToolTip>
                            <TextBlock Style="{StaticResource IconGlyph}">
                                <TextBlock.Text>
                                    <Binding Path="Task.IsClosed" Converter="{StaticResource CloseReopenIcon}"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>

                        <Button Style="{StaticResource IconButton}" ToolTip="Delete permanently"
                                AutomationProperties.Name="Delete permanently"
                                Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="&#x2715;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource DangerBrush}"/>
                        </Button>

                        <Button Style="{StaticResource IconButton}" ToolTip="Info" AutomationProperties.Name="Info"
                                Command="{Binding ToggleInfoPanelCommand}">
                            <TextBlock Text="&#x24D8;" Style="{StaticResource IconGlyph}"/>
                        </Button>
                    </StackPanel>

                    <!-- Sized and unboxed like a document title/header, not a form field - the
                         toolbar above is the only chrome; everything below it is just the page. -->
                    <TextBox x:Name="TitleTextBox"
                             Text="{Binding Task.Text, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsReadOnly}"
                             FontSize="28" FontWeight="Bold" Padding="0" Margin="0,20,0,0"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderThickness="0" Background="Transparent"
                             SpellCheck.IsEnabled="True" ContextMenu="{StaticResource TextEditContextMenu}"
                             PreviewMouseRightButtonDown="TextBox_PreviewMouseRightButtonDown"
                             ContextMenuOpening="TextBox_ContextMenuOpening"
                             KeyDown="TitleTextBox_KeyDown"
                             PreviewKeyDown="TitleTextBox_PreviewKeyDown"/>

                    <Border Background="{DynamicResource SecondaryHighlightBrush}" CornerRadius="3" Padding="10" Margin="0,8,0,0"
                            Visibility="{Binding ShowInfoPanel, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding CreatedDisplay, StringFormat='Created: {0}'}" FontSize="11.5"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding ModifiedDisplay, StringFormat='Modified: {0}'}" FontSize="11.5"
                                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding WordCount, StringFormat='Word count: {0}'}" FontSize="11.5"
                                       Foreground="{DynamicResource ForegroundBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Content only - excludes the status action row above (checkmark/pin/trash/delete/info),
                         which must stay usable even on a Completed or Trashed task. -->
                    <StackPanel IsEnabled="{Binding IsEditable}">
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Due date:" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding Task.DueDate}" HorizontalAlignment="Left" Width="150"/>
                            <TextBlock Grid.Column="2" Text="Repeat:" VerticalAlignment="Center" FontSize="13" Margin="16,0,8,0"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding RecurrenceOptions}" SelectedItem="{Binding Task.Recurrence}"
                                      HorizontalAlignment="Left" Width="110"/>
                        </Grid>

                        <TextBlock Text="{Binding RecurrenceSummary}" FontSize="11" FontStyle="Italic" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TertiaryBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding Task.Recurrence, Converter={StaticResource EnumNotEqualsVis}, ConverterParameter=None}"/>

                        <ItemsControl ItemsSource="{Binding Task.Tags}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource TagChipBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text=" &#x2715;" FontSize="10" Foreground="{DynamicResource ForegroundBrush}" Margin="4,0,0,0"
                                                       Cursor="Hand" VerticalAlignment="Center">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Unified note body: single continuous inline Word-like document canvas -->
                        <Grid x:Name="NoteBody" Background="Transparent" MinHeight="500" Margin="0,12,0,0"
                              AllowDrop="True"
                              DragEnter="NoteBody_DragEnter"
                              DragOver="NoteBody_DragOver"
                              DragLeave="NoteBody_DragLeave"
                              Drop="NoteBody_Drop">
                            <RichTextBox x:Name="NoteEditor"
                                         DataContext="{Binding PrimaryBlock}"
                                         Padding="0" VerticalContentAlignment="Top"
                                         MinHeight="500"
                                         Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         GotFocus="RichTextBox_GotFocus"
                                         LostFocus="RichTextBox_LostFocus"
                                         SelectionChanged="RichTextBox_SelectionChanged"
                                         PreviewMouseLeftButtonDown="RichTextBox_PreviewMouseLeftButtonDown"
                                         PreviewMouseRightButtonDown="RichTextBox_PreviewMouseRightButtonDown"
                                         ContextMenuOpening="RichTextBox_ContextMenuOpening"
                                         QueryCursor="RichTextBox_QueryCursor"
                                         PreviewMouseMove="RichTextBox_PreviewMouseMove"
                                         SpellCheck.IsEnabled="True"
                                         beh:RichTextBoxBehavior.Enable="True"
                                         ContextMenu="{StaticResource TextEditorContextMenu}"/>
                            <TextBlock Text="Start typing notes, instructions, paste images, or add links..." FontSize="14" FontStyle="Italic"
                                       Foreground="{DynamicResource TertiaryBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Top" Margin="0,2,0,0"
                                       Visibility="{Binding ElementName=NoteEditor, Path=(beh:RichTextBoxBehavior.IsEmpty), Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="DropOverlay" Background="#333361CC" BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2" CornerRadius="4" Margin="6" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
