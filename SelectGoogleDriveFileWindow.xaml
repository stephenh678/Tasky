<Window x:Class="TodoApp.SelectGoogleDriveFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a Tasky File" Height="440" Width="480" MinHeight="320" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/icon.ico"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,10"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Text="These .tasky files already exist on your Google Drive (only files Tasky itself has synced before can show up here). Pick one to sync with this computer, or create a new file that will sync to Drive too."/>

        <ListBox x:Name="RemoteFileListBox" Grid.Row="1"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 Background="{DynamicResource BackgroundBrush}"
                 BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1"
                 SelectionChanged="RemoteFileListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6,5">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding ModifiedText}" FontSize="11.5"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="UseSelectedButton" Content="Use Selected File" Padding="14,6" Margin="0,0,8,0" IsEnabled="False" Click="UseSelected_Click"/>
            <Button Content="Create New File &amp; Sync..." Padding="14,6" Margin="0,0,8,0" Click="CreateNew_Click"/>
            <Button Content="Cancel" Padding="14,6" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
