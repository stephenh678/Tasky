<Window x:Class="TodoApp.RestoreBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore from Backup" Height="440" Width="480" MinHeight="320" MinWidth="380"
        Icon="Assets/icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,10"
                   Foreground="{DynamicResource ForegroundBrush}"
                   Text="Select a backup to restore. Your current file is backed up first, so this can be undone by restoring again."/>

        <ListBox x:Name="BackupListBox" Grid.Row="1"
                 Foreground="{DynamicResource PrimaryTextBrush}"
                 Background="{DynamicResource BackgroundBrush}"
                 BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1"
                 SelectionChanged="BackupListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6,5">
                        <TextBlock Text="{Binding Timestamp, StringFormat='MMM d, yyyy \'at\' h:mm:ss tt'}"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding TaskCount, StringFormat='{}{0} task(s)'}" FontSize="11.5"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="RestoreButton" Content="Restore" Padding="14,6" IsEnabled="False" Click="Restore_Click"/>
        </StackPanel>
    </Grid>
</Window>
