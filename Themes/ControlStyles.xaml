<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:TodoApp.Converters">

    <!-- Generic control theming, shared by every window in the app (merged once in App.xaml,
         not per-window) so a themed Button/ComboBox/Menu/etc. looks right everywhere without
         each window re-declaring it. WPF's default (Aero2) chrome for Menu/Separator/ComboBox/
         Button bakes borders and fill colors into its own template rather than reading them from
         the Background/Foreground/BorderBrush properties, so a plain Setter on those properties
         is silently ignored for parts of the control - the fix throughout this file is a real
         ControlTemplate that only ever paints from the DynamicResource brushes below, never OS
         chrome. -->

    <FontFamily x:Key="IconFont">Segoe UI Emoji, Segoe UI Symbol, Segoe UI</FontFamily>

    <!-- Segoe Fluent Icons (Win11) / Segoe MDL2 Assets (Win10) - both OS-shipped, both map the
         same codepoints for common glyphs including Filter (E71C). Kept separate from IconFont
         above (which is emoji/dingbats, not a real icon font) rather than switched wholesale,
         since most of IconFont's existing glyphs (+, trash, gear, etc.) aren't guaranteed to exist
         at the same codepoints in this font. -->
    <FontFamily x:Key="FluentIconFont">Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol, Segoe UI</FontFamily>

    <!-- Rounded-square "mark complete" toggle - a hollow box that fills solid with a checkmark
         once toggled, matched to the same rounded-box shape Tasky Web/Mobile use for their task
         rows (see docs/css/styles.css's .done-checkbox-wrap) so the control looks the same across
         all three platforms. The fill/check color is a fixed blue rather than DynamicResource
         AccentBrush, since the dark theme's accent is a much lighter blue that a white checkmark
         would wash out against. Used for both the task list row toggle and the editor's Done
         toggle. -->
    <Style x:Key="TaskCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="22" Height="22">
                        <Border x:Name="Box" CornerRadius="5" BorderThickness="1.6"
                                BorderBrush="{DynamicResource TertiaryBrush}" Background="Transparent"/>
                        <Path x:Name="Check" Data="M5,11 L9,15 L17,6" Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#3361CC"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#3361CC"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#3361CC"/>
                        </Trigger>
                        <!-- The template fully owns rendering, so WPF's usual automatic disabled-state
                             dimming never kicks in without this - a locked toggle (a task in Trash)
                             would otherwise look identical to a live one. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="Check" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Rounded-square checkbox for lists of independent on/off options (the quick-filter popup) -
         smaller (15x15 vs. 22x22) and themed with ButtonBackgroundBrush/ButtonForegroundBrush
         instead of TaskCheckBox's fixed blue, so the two read as different controls doing
         different jobs ("mark this task done" vs. "this filter is active") despite sharing the
         same rounded-box shape. Dark theme's AccentBrush is a light blue that a white checkmark
         would wash out against, and those two resources are already the app's fixed-regardless-of-
         theme "accent action" pair (used for real Button chrome elsewhere), not a one-off literal. -->
    <Style x:Key="FilterCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Row-wide hover box (HighlightBrush, CornerRadius 3) - same idea as the
                         default Button style's IsMouseOver trigger that "Clear all filters"/"Save
                         current search as view" already get below in this same popup, and the same
                         idiom the View menu's own items use (MenuItemSubmenuHeaderTemplate). Without
                         this, only the little 15x15 checkbox glyph reacted to hover - the popup's
                         filter rows looked and behaved differently from every other item next to
                         them instead of like one consistent menu. -->
                    <Border x:Name="RowHighlight" Background="Transparent" CornerRadius="3" Padding="4,3">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="15" Height="15" Margin="0,0,8,0">
                                <Border x:Name="Box" CornerRadius="3" BorderThickness="1.4"
                                        BorderBrush="{DynamicResource TertiaryBrush}" Background="Transparent"/>
                                <Path x:Name="Check" Data="M2.5,7.5 L6,11 L12.5,3.5"
                                      Stroke="{DynamicResource ButtonForegroundBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ButtonBackgroundBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ButtonBackgroundBrush}"/>
                            <Setter TargetName="RowHighlight" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="3" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryHighlightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ThemedListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryHighlightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <conv:ObjectsEqualConverter x:Key="ObjectsEqual"/>

    <!-- Sidebar's three sections (Sidebar/Tags/Views ListBoxes) all bind SelectedItem to the same
         MainViewModel.SelectedSidebarItem, so only one of the three should ever look selected at
         once - but that turned out not to hold up in practice: relying on Selector.SelectedItem's
         own TwoWay binding to clear a list's highlight once the shared value pointed at an item
         that isn't in that list's own Items silently failed to happen reliably (reported live:
         switching between a saved View, a Tag, and a built-in section could leave more than one of
         the three highlighted at once, with no way to clear it short of typing in the search box -
         see also MainWindow.xaml.cs's comment on the StackOverflowException an earlier imperative
         fix attempt caused). Deliberately NOT based on ThemedListBoxItem above (still used by
         TaskListBox's own, unrelated multi-selection) - this ignores IsSelected entirely and
         computes the highlight fresh every time from "is this item actually the current selection,"
         via ObjectsEqual (SidebarFilterItem.Equals) rather than trusting inherited Selector state.
         Selecting still works the normal way (clicking sets SelectedItem, which still pushes to
         SelectedSidebarItem via the binding on the ListBox itself) - only the VISUAL highlight
         source changes here. -->
    <Style x:Key="SidebarListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Both triggers live in this one Style.Triggers collection (rather than splitting hover
             into the ControlTemplate above) so plain XML document order decides which wins when
             both are true at once, same as ThemedListBoxItem's original single-collection ordering
             - IsMouseOver first, selection second, so hovering an already-selected item keeps
             showing the selected color instead of flickering to the hover color. -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryHighlightBrush}"/>
            </Trigger>
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource ObjectsEqual}">
                        <Binding/>
                        <Binding Path="DataContext.SelectedSidebarItem" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Background" Value="{DynamicResource HighlightBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TaskListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ThemedListBoxItem}">
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
    </Style>

    <ControlTemplate x:Key="MenuItemLeafTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,6" Margin="2,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon" Width="14" Height="14" VerticalAlignment="Center"/>
                <Path x:Name="CheckMark" Grid.Column="0" Visibility="Collapsed" Data="M0,4 L3,7 L8,0"
                      Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"
                      Width="10" Height="8" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="20,0,0,0" FontSize="11.5"
                           Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItemTopLevelHeaderTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="8,5">
            <Grid>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SecondaryBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,2,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
                        </Border.Effect>
                        <ItemsPresenter/>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItemSubmenuHeaderTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,6" Margin="2,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="&#x25B6;" FontSize="9" Margin="16,0,0,0"
                           Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SecondaryBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="3">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
                        </Border.Effect>
                        <ItemsPresenter/>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Role=TopLevelHeader covers two visually different cases WPF doesn't distinguish: the real
         menu-bar headers (File/Edit/...), which drop straight down, AND any ContextMenu item that
         itself has a submenu (e.g. Font Size/Text Color/Highlight in the text-block right-click
         menu) - those need to flyout right with an arrow instead, same as a nested SubmenuHeader.
         Defaulting TopLevelHeader to the flyout-right look covers the (more common) second case;
         real menu-bar items override it locally where they're declared, since a local Template
         setter beats this style trigger.

         Background is Transparent, not a theme brush - the three templates below bind their own
         Border straight to this property (TemplateBinding Background), and each one already has
         its own IsHighlighted trigger that paints HighlightBrush on hover/selection. A solid
         default here used to paint every single item's own little rounded rectangle permanently,
         in a color that didn't match whatever popup it sat inside (SidebarBackgroundBrush is the
         Menu bar's own color, not the dropdown Popups' BackgroundBrush) - reported live as "each of
         the dropdown options has a different color box around them," happening at every color and
         at rest, not just on hover. Same flat-until-hovered pattern already used correctly by
         ListBoxItem/Button above and matching Fluent/WinUI menu guidance (items stay flat; only the
         hovered/pressed one gets a highlight fill). Transparent lets whatever this item is actually
         sitting on - the Menu bar for a top-level header, a Popup's Border for everything else -
         show through uniformly instead of stamping a second, mismatched color on top of it. -->
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuItemSubmenuHeaderTemplate}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource MenuItemLeafTemplate}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource MenuItemLeafTemplate}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource MenuItemSubmenuHeaderTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <!-- Same lesson as Menu/ComboBox/Button: a bare ContextMenu attached via the
         FrameworkElement.ContextMenu property (as opposed to a MenuItem's own Popup, which we
         already fully own via MenuItemTopLevelHeaderTemplate/MenuItemSubmenuHeaderTemplate) still
         renders through WPF's default Aero2 chrome underneath - property setters alone left a
         stray white highlight bar and a white sliver (its built-in scroll-indicator chrome)
         showing through. Full retemplate, matching the Border+ItemsPresenter approach already
         used for the Menu popups. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SecondaryBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="3">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
                        </Border.Effect>
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The default Separator template draws a 3D bevel (light top edge, dark bottom edge) from
         chrome colors that Background alone doesn't reach - a flat single-color line replaces it
         outright. -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="Margin" Value="4,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1" Margin="{TemplateBinding Margin}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WPF MenuItem popups apply MenuItem.SeparatorStyleKey to separators inside dropdown menus,
         which defaults to Aero2's 3/4 white line. Overriding it here matches the app theme. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="Margin" Value="4,4"/>
    </Style>

    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolBar">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="0,0,0,1">
                        <ToolBarPanel IsItemsHost="True" Orientation="Horizontal" Margin="4,3"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain Button previously only set Foreground, leaving every un-styled button (dialog
         Cancel/OK, block "Open" buttons, etc.) with the default Aero2 gray/white fill regardless
         of theme. Full retemplate so background actually follows the theme too. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SecondaryHighlightBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same lesson as MenuItem: the default ComboBox template's toggle-button area paints its
         own chrome background underneath, which plain Background/Foreground setters don't reach.
         Full retemplate instead. -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{DynamicResource BackgroundBrush}"
                                            BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1" CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="&#x25BE;" FontSize="9"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryHighlightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SecondaryBrush}"
                                    BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsPresenter/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Without this, each item in a ComboBox's dropdown popup falls back to its own default
         foreground/background rather than inheriting from the ComboBox style above. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="6,4" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <!-- Replaces the OS's default dashed-rectangle keyboard focus adorner, which was suppressed
         below (FocusVisualStyle) because it drew as an ugly box flush against the note editor's
         borderless text - a plain thin accent-colored outline instead, WCAG 2.4.7-compliant
         without reintroducing that box look. -->
    <Style x:Key="RichTextBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Unlike TextBox above, RichTextBox's Aero2 default template paints its own focus-state
         border directly (not through the Background/BorderThickness properties), so setting those
         locally on the note editor still left a visible box the instant it gained focus - the same
         class of issue this whole file works around. PART_ContentHost is a hard WPF requirement
         for TextBoxBase-derived controls to actually host and scroll their text content; without
         that exact name the control silently fails to render. -->
    <Style TargetType="RichTextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RichTextBoxFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RichTextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" BorderThickness="0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolBar assigns its OWN default style to child Button/ComboBox/Separator elements (via
         these specific resource keys), which silently overrides a plain implicit style targeting
         Button/ComboBox for anything placed inside a ToolBar. Toolbar buttons deliberately stay
         flat (background only on hover) rather than reusing the bordered default Button look -
         a dozen bordered boxes packed edge-to-edge in a toolbar reads as cluttered; a real
         border only earns its place on a standalone dialog button (Cancel/OK/Yes/No). -->
    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryHighlightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static ToolBar.ComboBoxStyleKey}" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>
    <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
    </Style>

</ResourceDictionary>
