<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-SDK-versioned TFM (rather than plain net9.0-windows) so NuGet resolves the
         Windows10-specific asset of CommunityToolkit.WinUI.Notifications, which is the one that
         actually has the WinRT-backed toast activation APIs (DesktopNotificationManagerCompat,
         ToastNotificationActivatedEventArgsCompat) - the plain net5.0 asset lacks them entirely.
         SupportedOSPlatformVersion keeps the app launchable on Windows 10 1809+ (the minimum for
         unpackaged desktop toast notifications) while compiling against the 19041 API surface. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Tasky</AssemblyName>
    <AssemblyTitle>Tasky</AssemblyTitle>
    <Product>Tasky</Product>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.1.4</Version>
    <!-- Baked in rather than left as CLI-only flags in README.md's publish command - a publish
         that forgets `-p:SelfContained=true -p:PublishSingleFile=true` silently produces a
         framework-dependent build with every dependency loose alongside Tasky.exe instead of
         bundled into it, which Uninstall-Tasky.ps1's known-files list doesn't expect. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- TodoApp.Tests lives in a subfolder of this project; without an explicit exclude its .cs
         files leak into this project's own compile glob (and, worse, into the WPF markup
         temp-project MSBuild generates for XAML codegen), pulling in xunit types this project
         doesn't reference. -->
    <Compile Remove="TodoApp.Tests\**" />
    <EmbeddedResource Remove="TodoApp.Tests\**" />
    <None Remove="TodoApp.Tests\**" />
    <Page Remove="TodoApp.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <!-- UseWindowsForms (needed for NotifyIcon, used for the tray icon and reminder
         notifications) auto-adds a GLOBAL implicit using for System.Windows.Forms
         project-wide, which collides with WPF's System.Windows/.Controls/.Input/.Media
         everywhere (Application, Brush, RichTextBox, etc. all exist in both). Strip just
         that one global using; TrayIconService.cs still gets it via its own explicit
         "using System.Windows.Forms;". -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.75.0.4218" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
