<Window x:Class="TodoApp.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="Assets/icon.ico"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="KeyBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="DescTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="⌨️" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Keyboard Shortcuts" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Quick key combinations for fast task management and note editing."
                           FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- General Shortcuts -->
        <GroupBox Grid.Row="1" Header="Task &amp; General Shortcuts" Foreground="{DynamicResource PrimaryTextBrush}"
                  Margin="0,0,0,12" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Ctrl + N" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="New Task" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Ctrl + Alt + T" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Global Quick Add" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Delete" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Delete Selected" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Ctrl + Z" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Undo Last Action" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Ctrl + O" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Open File" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Ctrl + Shift + S" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Save As" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Ctrl + E" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Export / Print Note" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="F11" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Toggle Focus Mode" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="F12" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Toggle Calendar View" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Ctrl + Shift + G" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Sync Google Drive Now" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Ctrl + F" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Jump to Search" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Inline Note Insertion Shortcuts -->
        <GroupBox Grid.Row="2" Header="Editor &amp; Note Insertion Shortcuts" Foreground="{DynamicResource PrimaryTextBrush}"
                  Margin="0,0,0,12" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Ctrl + Shift + P" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Insert Photo" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Ctrl + Shift + L" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Insert Link" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Ctrl + Shift + F" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Insert File" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Ctrl + Shift + C" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Insert Checklist" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="Ctrl + Shift + K" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Insert Table" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Border Style="{StaticResource KeyBadgeStyle}"><TextBlock Text="F1  or  Ctrl + ?" Style="{StaticResource KeyTextStyle}"/></Border>
                    <TextBlock Text="Shortcuts Help" Style="{StaticResource DescTextStyle}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Close Button -->
        <Button Grid.Row="3" Content="Close" Padding="16,6" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click"/>
    </Grid>
</Window>
