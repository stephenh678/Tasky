<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#161F30"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0F17"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#111827"/>
    <!-- Slate-400 #94A3B8 clears 5.4:1 against #161F30 and 6.1:1 against #111827 (WCAG AA) -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#94A3B8"/>
    <!-- Slate-50 #F8FAFC clears 12.8:1 against #161F30 and 14.5:1 against #111827 (WCAG AAA) -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#1E293B"/>
    <!-- Slate-500 #64748B -->
    <SolidColorBrush x:Key="TertiaryBrush" Color="#64748B"/>
    <!-- Blue-500 #3B82F6 clears 4.5:1 against #161F30 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#334155"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="SecondaryHighlightBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="TagChipBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>

    <!-- Native WPF chrome (Menu/MenuItem popups, ToolBar padding, ComboBox dropdowns, DatePicker)
         reads these SystemColors keys internally for parts that aren't exposed as simple
         Background/Foreground properties. Overriding them here is what actually makes those
         controls follow the app theme instead of the OS theme. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1D2327"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2C3338"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#3C434A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#1D2327"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#2C3338"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2C3338"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#3361CC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3361CC"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#8C8F94"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#3C434A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="#2C3338"/>
</ResourceDictionary>
