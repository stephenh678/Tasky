<UserControl x:Class="TodoApp.GoogleDriveSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Viewbox Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                <Canvas Width="87.3" Height="78">
                    <Path Fill="#FFD04B" Data="M 6,52 L 21.5,78 L 81.3,78 L 65.8,52 Z"/>
                    <Path Fill="#0F9D58" Data="M 65.8,52 L 81.3,78 L 51.7,26 L 36.2,0 Z"/>
                    <Path Fill="#4285F4" Data="M 36.2,0 L 6,52 L 21.5,78 L 51.7,26 Z"/>
                </Canvas>
            </Viewbox>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Google Drive Cloud Sync" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Sync your tasks &amp; attachments across multiple devices using Google Drive."
                           FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Connection Status Card -->
        <Border Grid.Row="1" Background="{DynamicResource SecondaryBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Status" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="AccountEmailText" Text="No account connected" FontSize="12"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="DisconnectButton" Grid.Column="1" Content="Disconnect" Padding="10,4"
                            VerticalAlignment="Center" Visibility="Collapsed" Click="Disconnect_Click"/>
                </Grid>

                <Separator Margin="0,10,0,10" Background="{DynamicResource BackgroundBrush}"/>

                <TextBlock x:Name="LastSyncText" Text="Last Synced: Never" FontSize="11.5" Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
        </Border>

        <!-- Primary Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="ConnectButton" Content="🔑 Connect &amp; Sign In with Google"
                    Padding="16,10" FontWeight="SemiBold" FontSize="13" Click="Connect_Click"/>
            <Button x:Name="SyncNowButton" Content="🔄 Sync Now" Visibility="Collapsed"
                    Padding="16,10" FontWeight="SemiBold" FontSize="13" Click="SyncNow_Click"/>
            <Button x:Name="ChooseFileButton" Content="📄 Choose File..." Visibility="Collapsed" Margin="8,0,0,0"
                    Padding="16,10" FontSize="13" Click="ChooseFile_Click"/>
        </StackPanel>

        <!-- Status / Progress Message -->
        <TextBlock x:Name="ProgressStatusText" Grid.Row="3" Text="" FontSize="12"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <!-- Optional Advanced API Credentials Expander -->
        <Expander Grid.Row="4" Header="Advanced API Credentials (Optional)" Margin="0,0,0,12"
                  IsExpanded="False" Foreground="{DynamicResource ForegroundBrush}" FontSize="11.5">
            <Border Background="{DynamicResource SecondaryBrush}" CornerRadius="4" Padding="12" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Optional: Override default app credentials with your custom Google OAuth Client ID:"
                               TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8"/>

                    <TextBlock Text="Client ID:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                    <TextBox x:Name="ClientIdTextBox" Padding="5,3" Margin="0,0,0,8"
                             Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <TextBlock Text="Client Secret:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                    <TextBox x:Name="ClientSecretTextBox" Padding="5,3" Margin="0,0,0,10"
                             Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="📁 Import client_secret.json" Padding="8,4" Click="ImportJson_Click"/>
                        <Button Grid.Column="2" Content="🌐 Open Console" Padding="8,4" Click="OpenConsole_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Expander>
    </Grid>
</UserControl>
