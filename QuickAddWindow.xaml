<Window x:Class="TodoApp.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Add Task" Width="480" SizeToContent="Height"
        Icon="Assets/icon.ico"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource SecondaryBrush}"
            BorderThickness="1" CornerRadius="12" Margin="16" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource FluentIconFont}" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Quick Add Task" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Esc to cancel" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TertiaryBrush}"/>
            </Grid>

            <!-- Input Box in rounded container -->
            <Border Grid.Row="1" Background="{DynamicResource SecondaryHighlightBrush}"
                    BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                <Grid>
                    <TextBox x:Name="TitleBox" FontSize="14" Padding="6,4"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Background="Transparent" BorderThickness="0"
                             SpellCheck.IsEnabled="True"
                             KeyDown="TitleBox_KeyDown"
                             TextChanged="TitleBox_TextChanged"
                             PreviewMouseRightButtonDown="TitleBox_PreviewMouseRightButtonDown"
                             ContextMenuOpening="TitleBox_ContextMenuOpening">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Cu_t" Command="Cut"/>
                                <MenuItem Header="_Copy" Command="Copy"/>
                                <MenuItem Header="_Paste" Command="Paste"/>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                    <TextBlock Text="What needs to be done? (#tag, tomorrow 3pm, every monday)"
                               FontSize="14" Foreground="{DynamicResource PlaceholderBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"
                               Visibility="{Binding Text.IsEmpty, ElementName=TitleBox, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- Preview & Hints -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <TextBlock x:Name="PreviewText" Text="Press Enter to add · #tag · tomorrow 3pm · every monday" FontSize="11"
                           Foreground="{DynamicResource TertiaryBrush}" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>
    </Border>
</Window>

