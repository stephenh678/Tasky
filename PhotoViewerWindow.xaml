<Window x:Class="TodoApp.PhotoViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo" Height="700" Width="900" MinHeight="300" MinWidth="400"
        Icon="Assets/icon.ico"
        WindowStartupLocation="CenterOwner" Background="Black"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid MouseLeftButtonUp="Grid_MouseLeftButtonUp">
        <Image x:Name="PhotoImage" Stretch="Uniform" Margin="16"/>
        <Button Content="&#x2715;" Click="Close_Click" Width="32" Height="32" FontSize="14"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                Background="#33FFFFFF" Foreground="White" BorderThickness="0" Cursor="Hand"
                ToolTip="Close" AutomationProperties.Name="Close"/>
    </Grid>
</Window>
