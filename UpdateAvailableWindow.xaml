<Window x:Class="TodoApp.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available" Height="380" Width="440" MinHeight="300" MinWidth="360"
        Icon="Assets/icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="HeadlineText" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="SubText" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource ForegroundBrush}"/>
        </StackPanel>

        <Border x:Name="NotesBorder" Grid.Row="1" BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="PrimaryButton" Padding="14,6" Margin="0,0,8,0" IsDefault="True" Click="Primary_Click"/>
            <Button x:Name="SecondaryButton" Content="View on GitHub" Padding="14,6" Margin="0,0,8,0" Click="Secondary_Click"/>
            <Button x:Name="LaterButton" Content="Later" Padding="14,6" IsCancel="True" Click="Later_Click"/>
        </StackPanel>
    </Grid>
</Window>
