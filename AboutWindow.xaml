<Window x:Class="TodoApp.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Tasky" Width="360" MinWidth="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="Assets/icon.ico"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/icon.ico" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tasky" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="VersionText" FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="A simple task manager with notes, links, photos, due dates, and tags."
                       TextWrapping="Wrap" FontSize="12.5" Margin="0,14,0,0"
                       Foreground="{DynamicResource ForegroundBrush}"/>

            <TextBlock Margin="0,10,0,0" FontSize="12.5">
                <Hyperlink NavigateUri="https://github.com/stephenh678/Tasky"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Foreground="{DynamicResource AccentBrush}">
                    github.com/stephenh678/Tasky
                </Hyperlink>
            </TextBlock>

            <TextBlock Margin="0,10,0,0" FontSize="12.5" TextWrapping="Wrap">
                On a phone or another computer? Tasky Web is a mobile-friendly companion at
                <LineBreak/>
                <Hyperlink NavigateUri="https://stephenh678.github.io/Tasky/"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Foreground="{DynamicResource AccentBrush}">
                    stephenh678.github.io/Tasky
                </Hyperlink>
                — syncs through the same Google Drive file this app uses.
            </TextBlock>

            <TextBlock Margin="0,10,0,0" FontSize="12.5">
                <Hyperlink Click="ReplayTour_Click" Foreground="{DynamicResource AccentBrush}">
                    Replay welcome tour
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Button Grid.Row="1" Content="OK" Padding="16,7" HorizontalAlignment="Right" Margin="0,20,0,0"
                IsDefault="True" IsCancel="True" Click="Ok_Click"/>
    </Grid>
</Window>
